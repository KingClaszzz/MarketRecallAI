# Salin ke .env lalu isi nilainya

# Tatum (Mainnet)
TATUM_API_KEY=
TATUM_DATA_API_URL=https://api.tatum.io
TATUM_SUI_GRPC_HOST=sui-mainnet-grpc.gateway.tatum.io:443
TATUM_SUI_RPC_URL=https://sui-mainnet.gateway.tatum.io

# CoinGecko (market data, demo key)
COINGECKO_API_KEY=
COINGECKO_API_URL=https://api.coingecko.com/api/v3

# Walrus Memory
MEMWAL_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=
MEMWAL_AGENT_ID=
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
MEMWAL_MAX_WRITES_PER_DAY=150

# LLM (OpenAI-compatible Chat Completions; default vikey.ai + DeepSeek V4 Flash)
LLM_BASE_URL=https://api.vikey.ai/v1
LLM_API_KEY=
LLM_MODEL=deepseek/deepseek-v4-flash
# matikan mode berpikir model reasoning supaya jawaban tidak kosong
LLM_DISABLE_THINKING=true

# Database: kosongkan untuk SQLite lokal (backend/data/marketrecall.db); isi URL Postgres untuk production
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# App
FORECAST_HORIZON_H=4
RECALL_N_MIN=8
ADMIN_TOKEN=

# Keamanan (wajib diubah saat deploy)
# CORS_ORIGINS: daftar origin frontend yang boleh memanggil API, format JSON
CORS_ORIGINS=["http://localhost:5173"]
# APP_DOMAIN: domain yang tertulis di pesan login wallet
APP_DOMAIN=localhost:5173
# EXPOSE_DOCS: true hanya untuk development (/docs dan /openapi.json)
EXPOSE_DOCS=false
# TRUST_PROXY: true hanya jika backend di belakang proxy milikmu sendiri (membaca X-Forwarded-For)
TRUST_PROXY=false
# PROXY_HOPS: jumlah proxy tepercaya di depan backend (HF Spaces: 1)
PROXY_HOPS=1
